{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "employee",
						"type": "DatasetReference"
					},
					"name": "employee"
				},
				{
					"dataset": {
						"referenceName": "department",
						"type": "DatasetReference"
					},
					"name": "department"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureBlobStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "join2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          emp_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          dept_id as string,",
				"          job_title as string,",
				"          hire_date as string,",
				"          salary as string,",
				"          manager_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> employee",
				"source(output(",
				"          dept_id as string,",
				"          dept_name as string,",
				"          location as string,",
				"          manager_id as string,",
				"          budget as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> department",
				"filter1, derivedColumn1 join(employee@dept_id == department@dept_id,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"department derive(location = upper(location)) ~> derivedColumn1",
				"derivedColumn2 filter(salary <= 80000) ~> filter1",
				"employee derive(salary = toInteger(salary),",
				"          hire_date = toDate(hire_date)) ~> derivedColumn2",
				"join2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          dept_id as string,",
				"          dept_name as string,",
				"          location as string,",
				"          manager_id as string,",
				"          budget as string",
				"     ),",
				"     partitionFileNames:['final'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}