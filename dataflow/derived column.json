{
	"name": "derived column",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "employee",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          emp_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          dept_id as string,",
				"          job_title as string,",
				"          hire_date as string,",
				"          salary as string,",
				"          manager_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(first_name = upper(first_name),",
				"          {Full Name} = concat(first_name,' ', last_name),",
				"          salary_band = case(",
				"  toInteger(salary) > 120000, 'manager',",
				"  toInteger(salary) > 100000, 'senior associate',",
				"  toInteger(salary) > 90000, 'associate',",
				"  'analyst'",
				"),",
				"          manager_id = iif(isNull(manager_id), 'Manager', manager_id)) ~> derivedColumn1"
			]
		}
	}
}