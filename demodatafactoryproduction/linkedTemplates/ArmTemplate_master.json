{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "demodatafactoryproduction"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"filedrop_properties_pipeline1_parameters_Sourcepath": {
			"type": "string",
			"defaultValue": "@triggerBody().filePath"
		},
		"filedrop_properties_pipeline1_parameters_SourceFile": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"filedrop_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/3f3116a5-68e5-42c9-a744-55a0701c6816/resourceGroups/TestEnvironment/providers/Microsoft.Storage/storageAccounts/testenvironment123"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "demodatafactoryproduction_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"filedrop_properties_pipeline1_parameters_Sourcepath": {
						"value": "[parameters('filedrop_properties_pipeline1_parameters_Sourcepath')]"
					},
					"filedrop_properties_pipeline1_parameters_SourceFile": {
						"value": "[parameters('filedrop_properties_pipeline1_parameters_SourceFile')]"
					},
					"filedrop_properties_typeProperties_scope": {
						"value": "[parameters('filedrop_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}